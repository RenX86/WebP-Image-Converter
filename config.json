{
    "webp_quality": 100,
    "delete_originals": false,
    "lossless": false,
    "overwrite": false,
    "supported_formats": [
        ".jpg",
        ".jpeg",
        ".png",
        ".tif",
        ".tiff",
        ".bmp",
        ".gif"
    ],
    "max_workers": 12,
    "tool_paths": {
        "cwebp": "bin/cwebp.exe",
        "exiftool": "bin/exiftool.exe",
        "gif2webp": "gif2webp"
    }
}
